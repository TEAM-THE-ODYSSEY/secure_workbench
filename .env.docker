# === MRPL Knowledge Platform — Docker Environment ===
POSTGRES_URI=postgresql+psycopg://postgres:postgres@postgres:5432/mrpl_rag
USE_IN_MEMORY_FALLBACK=False

REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_ENABLED=True

EMBEDDING_MODEL_NAME=BAAI/bge-m3
EMBEDDING_DIMENSION=1024
EMBEDDING_DEVICE=cpu

SECURITY_ENABLED=True
CLAMAV_HOST=clamav
CLAMAV_PORT=3310
CLAMAV_ENABLED=True
PROMPT_INJECTION_ENABLED=True
CONTRADICTION_DETECTION_ENABLED=True

LOG_LEVEL=INFO

# === PaddlePaddle / PaddleOCR Runtime Flags ===
PADDLE_PDX_ENABLE_MKLDNN_BYDEFAULT=0
PADDLE_PDX_DISABLE_MODEL_SOURCE_CHECK=True

# === Reasoning Agent vLLM Model Configuration ===
VLLM_API_BASE=http://host.docker.internal:8001/v1
PRIMARY_MODEL_NAME=Qwen/Qwen2.5-1.5B-Instruct-AWQ
FALLBACK_MODEL_NAME=Qwen/Qwen2.5-1.5B-Instruct-AWQ
DEVELOPMENT_LOW_VRAM=True
PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True
VLLM_GPU_MEMORY_UTILIZATION=0.65
MAX_MODEL_LEN=2048
